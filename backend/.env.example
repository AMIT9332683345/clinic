# Copy to .env for local development. NEVER commit the real .env
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/clinic?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000
CLINIC_TZ=Asia/Kolkata
PORT=5000